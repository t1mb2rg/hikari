# Hikari runtime model configuration.
# Copy this file to `.env` for local development. `.env` is ignored by Git.
# Keep the API key private; never commit a real key.

HIKARI_MODEL_BASE_URL=https://api.deepseek.com
HIKARI_MODEL_NAME=deepseek-v4-flash
HIKARI_MODEL_API_KEY=replace-with-your-own-key

# Direct conversation is allowed to be a little less rigid than background Presence cognition.
# Optional; defaults to 0.65 when omitted.
HIKARI_CHAT_TEMPERATURE=0.65

# M6-09 resident-owned Conversation Host.
# The resident enables Conversation by default; set false only for Presence-only debugging.
HIKARI_CONVERSATION_ENABLED=true
# Whiteboard 0 A/B switch. grounded keeps the current full grounding path; whiteboard sends
# only Hikari's whiteboard prompt + recent same-conversation turns + the current user message.
HIKARI_CONVERSATION_CONTEXT_PROFILE=grounded
# The listener remains loopback-only. Remote deployment requires secure WSS ingress later.
HIKARI_CONVERSATION_HOST=127.0.0.1
HIKARI_CONVERSATION_PORT=8765
HIKARI_CONVERSATION_URL=ws://127.0.0.1:8765
HIKARI_CONVERSATION_SHARED_SECRET=

# M7-07 Hikari-owned Engineering Runtime.
# Engineering cognition runs through Claude Code but has its own executable/model identity.
# Do not reuse HIKARI_MODEL_NAME (Conversation/Presence) or rely on ambient model variables.
HIKARI_ENGINEERING_ENABLED=false
HIKARI_ENGINEERING_CLAUDE_EXECUTABLE=claude
# This may be a Claude alias/id or another model identifier supported by your Claude Code route.
HIKARI_ENGINEERING_MODEL=sonnet
# One backend turn cannot run forever while the Worker heartbeat remains healthy.
HIKARI_ENGINEERING_BACKEND_TIMEOUT_SECONDS=300
HIKARI_ENGINEERING_MAX_TURNS=30

# Legacy M7-02 Forge bridge. Keep disabled once Hikari Engineering Runtime owns project work.
HIKARI_FORGE_ENABLED=false
HIKARI_FORGE_PROJECT_ID=hikari
# Leave blank to use the resident repository argument as the trusted project root.
HIKARI_FORGE_REPOSITORY=
HIKARI_FORGE_EXECUTABLE=forge
HIKARI_FORGE_BACKEND=claude
HIKARI_FORGE_MAX_ATTEMPTS=3
HIKARI_FORGE_CLAUDE_PERMISSION_MODE=auto
HIKARI_FORGE_CLAUDE_MAX_TURNS=30
# Pending confirmation is scoped to one channel/conversation and expires.
HIKARI_FORGE_CONFIRMATION_TTL_SECONDS=600

# QQ / NapCat OneBot V11 bridge.
# Set true to let hikari-resident supervise Hikari's own hikari-qq child process.
HIKARI_QQ_ENABLED=false
# hikari-qq runs a loopback-only NoneBot reverse WebSocket endpoint at:
# ws://127.0.0.1:8081/onebot/v11/ws
HIKARI_ONEBOT_HOST=127.0.0.1
HIKARI_ONEBOT_PORT=8081
HIKARI_ONEBOT_ADAPTER_ID=qq.main
# Fail-closed allowlist. At least one QQ user id is required when QQ is enabled.
HIKARI_ONEBOT_ALLOWED_USER_IDS=replace-with-your-qq-id
# M6-11 proactive delivery has a separate fixed trusted destination.
# The value must also appear in HIKARI_ONEBOT_ALLOWED_USER_IDS. Leave blank to disable proactive QQ delivery.
HIKARI_QQ_PROACTIVE_USER_ID=
# Poll the durable proactive outbox while OneBot is connected.
HIKARI_QQ_DELIVERY_POLL_SECONDS=1
# Retry failed durable Conversation turns with bounded exponential backoff.
HIKARI_QQ_CONVERSATION_RETRY_INITIAL_SECONDS=5
HIKARI_QQ_CONVERSATION_RETRY_MAX_SECONDS=60
# Optional on loopback. If configured in NapCat, the values must match.
HIKARI_ONEBOT_ACCESS_TOKEN=
# A quiet QQ session is probed with get_status() after this many seconds without events.
HIKARI_ONEBOT_LINK_TIMEOUT_SECONDS=300
HIKARI_ONEBOT_LINK_CHECK_SECONDS=60

# Minimal NapCat Login Guard. On Windows this is enabled by default with QQ.
# It checks the real QQ login state and restarts only the named NapCat task at
# most once per durable outage. It never stores a QQ password or retries Hikari
# delivery records. A failed quick login requires manual WebUI verification.
HIKARI_NAPCAT_LOGIN_GUARD_ENABLED=true
HIKARI_NAPCAT_ROOT=D:\NapCat-Shell-v4.18.19
HIKARI_NAPCAT_TASK_NAME=Hikari NapCat Shell
# Login checks are intentionally limited to 30-60 seconds.
HIKARI_NAPCAT_LOGIN_CHECK_SECONDS=45
# Give NapCat quick login time to recover after its one allowed restart.
HIKARI_NAPCAT_LOGIN_RECOVERY_SECONDS=90

# M6-12 governed Presence interruption policy.
# Channel and recipient are trusted runtime configuration, never model output.
HIKARI_PRESENCE_CHANNEL=windows
# Recommended production default: suppress ordinary proactive interruptions overnight.
HIKARI_PRESENCE_QUIET_HOURS_ENABLED=true
HIKARI_PRESENCE_QUIET_START=23:00
HIKARI_PRESENCE_QUIET_END=07:00
# Accepted/queued ordinary interruptions start a global cooldown.
HIKARI_PRESENCE_COOLDOWN_SECONDS=300
# Equivalent accepted events are suppressed for this window, including urgent duplicates.
HIKARI_PRESENCE_DUPLICATE_WINDOW_SECONDS=3600
# Only deterministic Attention importance at or above this threshold may bypass quiet/busy/cooldown.
HIKARI_PRESENCE_URGENT_THRESHOLD=0.95
# A current schedule item suppresses ordinary interruption without claiming the user is definitely busy.
HIKARI_PRESENCE_SUPPRESS_ACTIVE_SCHEDULE=true
# Optional comma-separated foreground-title substrings that suppress ordinary interruptions.
HIKARI_PRESENCE_BUSY_FOREGROUND_PATTERNS=
