# Hikari runtime model configuration.
# Copy this file to `.env` for local development. `.env` is ignored by Git.
# Keep the API key private; never commit a real key.

HIKARI_MODEL_BASE_URL=https://api.deepseek.com
HIKARI_MODEL_NAME=deepseek-v4-flash
HIKARI_MODEL_API_KEY=replace-with-your-own-key

# Direct conversation is allowed to be a little less rigid than background Presence cognition.
# Optional; defaults to 0.65 when omitted.
HIKARI_CHAT_TEMPERATURE=0.65

# M6-09 resident-owned Conversation Host.
# The resident enables Conversation by default; set false only for Presence-only debugging.
HIKARI_CONVERSATION_ENABLED=true
# The listener remains loopback-only. Remote deployment requires secure WSS ingress later.
HIKARI_CONVERSATION_HOST=127.0.0.1
HIKARI_CONVERSATION_PORT=8765
HIKARI_CONVERSATION_URL=ws://127.0.0.1:8765
HIKARI_CONVERSATION_SHARED_SECRET=

# QQ / NapCat OneBot V11 bridge.
# Set true to let hikari-resident supervise Hikari's own hikari-qq child process.
# This does NOT start, restart, log in, or automate NapCat / QQ.
HIKARI_QQ_ENABLED=false
# hikari-qq runs a loopback-only NoneBot reverse WebSocket endpoint at:
# ws://127.0.0.1:8081/onebot/v11/ws
HIKARI_ONEBOT_HOST=127.0.0.1
HIKARI_ONEBOT_PORT=8081
HIKARI_ONEBOT_ADAPTER_ID=qq.main
# Fail-closed allowlist. At least one QQ user id is required when QQ is enabled.
HIKARI_ONEBOT_ALLOWED_USER_IDS=replace-with-your-qq-id
# M6-11 proactive delivery has a separate fixed trusted destination.
# The value must also appear in HIKARI_ONEBOT_ALLOWED_USER_IDS. Leave blank to disable proactive QQ delivery.
HIKARI_QQ_PROACTIVE_USER_ID=
# Poll the durable proactive outbox while OneBot is connected.
HIKARI_QQ_DELIVERY_POLL_SECONDS=1
# Optional on loopback. If configured in NapCat, the values must match.
HIKARI_ONEBOT_ACCESS_TOKEN=
# A quiet QQ session is probed with get_status() after this many seconds without events.
HIKARI_ONEBOT_LINK_TIMEOUT_SECONDS=300
HIKARI_ONEBOT_LINK_CHECK_SECONDS=60
